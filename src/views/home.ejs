<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <% if (locals.isAuthenticated) { %>
    <p>Welcome back, <strong><%= locals.currentUser?.name %></strong>!</p>
    <p>Your role: <strong><%= locals.currentUser?.role %></strong>.</p>

    <div class="dashboard-actions">
      <a class="button" href="/organizations">Browse Organizations</a>
      <a class="button" href="/projects">Browse Projects</a>
      <% if (locals.isAdmin) { %>
        <a class="button accent" href="/users">Manage Registered Users</a>
      <% } %>
    </div>
  <% } else { %>
    <h2>Welcome to the CSE 340 Service Network!</h2>

    <p>
      Our mission is to promote service across the world by connecting volunteers with service opportunities in their community.
    </p>

    <p>
      Please <a href="/login">log in</a> or <a href="/register">create an account</a> to continue.
    </p>
  <% } %>

  <img class="main-logo" src="images/cse340-service-network.png" alt="CSE 340 Service Network Logo">
</main>

<%- include('partials/footer') %>
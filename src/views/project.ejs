<%- include('partials/header') %>

	<main>

		<h1>
			<%= title %>
		</h1>

		<h2>
			<%= project.title %>
		</h2>

		<!-- Description -->
		<p>

			Description:
			<%= project.description %>

		</p>

		<!-- Date -->
		<p>

			Date:
			<%= project.project_date ? new Date(project.project_date).toLocaleDateString() : 'TBD' %>

		</p>

		<!-- Location -->
		<p>

			Location:
			<%= project.location || 'TBD' %>

		</p>

		<!-- Organization -->
		<p>

			Organization:

			<a href="/organization/<%= project.organization_id %>">

				<%= project.organization_name %>

			</a>

		</p>

		<!-- Categories -->
		<p>

			Categories:

			<% categories.forEach((category, index)=> { %>

				<a href="/category/<%= category.category_id %>">

					<%= category.name %>

				</a>

				<%= index < categories.length - 1 ? ', ' : '' %>

					<% }) %>

		</p>

		<!-- Edit Categories -->
		<p>

			<a href="/assign-categories/<%= project.project_id %>">

				Edit Categories

			</a>

		</p>

		<!-- Edit Project -->
		<p>

			<a href="/edit-project/<%= project.project_id %>">

				Edit Project

			</a>

		</p>

	</main>

	<%- include('partials/footer') %>